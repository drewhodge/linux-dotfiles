layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="Helix IDE" focus=true {
        pane split_direction="vertical" {
            // Left Column (20% Width)
            pane size="20%" name="Yazi File Manager" {
                command "sh"
                args "-c" "YAZI_CONFIG_HOME=~/.config/zellij/layouts/yazi-ide yazi"
            }
            
            // Right Column (80% Width)
            pane size="80%" split_direction="horizontal" {
                // Top Right: Editor and Git
                pane size="75%" split_direction="vertical" {
                    pane name="Helix Text Editor" focus=true {
                        command "helix"
                    }
                    pane name="Lazygit Version Control" {
                        command "lazygit"
                    }
                }
                // Bottom Right: Terminals
                pane size="25%" split_direction="vertical" {
                    pane name="Terminal One" {}
                    pane name="Terminal Two" {}
                }
            }
        }
    }
}


